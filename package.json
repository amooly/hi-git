{
    "name": "hi-git",
    "displayName": "Hi Git",
    "description": "A VS Code extension to visualize Git graph and compare branches/tags.",
    "version": "0.1.251205",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "hi-git.showWorkspaceGitGraph",
                "title": "Hi Git: Show Workspace Git Graph"
            },
            {
                "command": "hi-git.showGitHistoryOf",
                "title": "Hi Git: Show Git History"
            },
            {
                "command": "hi-git.compareWithBranchOrTag",
                "title": "Hi Git: Compare with Branch or Tag"
            },
            {
                "command": "hi-git.compareWithLocal",
                "title": "Hi Git: Compare with Local"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "hi-git.showGitHistoryOf",
                    "group": "hi-git",
                    "when": "resourceScheme == file && gitOpenRepositoryCount > 0"
                },
                {
                    "command": "hi-git.compareWithBranchOrTag",
                    "group": "hi-git",
                    "when": "resourceScheme == file && gitOpenRepositoryCount > 0"
                },
                {
                    "command": "hi-git.showWorkspaceGitGraph",
                    "group": "hi-git",
                    "when": "resourceScheme == file && gitOpenRepositoryCount > 0"
                }
            ],
            "commandPalette": [
                {
                    "command": "hi-git.showWorkspaceGitGraph",
                    "when": "gitOpenRepositoryCount > 0"
                }
            ]
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "hi-git-explorer",
                    "title": "Hi Git",
                    "icon": "$(git-branch)"
                }
            ]
        },
        "views": {
            "hi-git-explorer": [
                {
                    "id": "hi-git.directoryDiff",
                    "name": "Directory Diff"
                },
                {
                    "id": "hi-git.commitDetails",
                    "name": "Commit Details"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "webpack",
        "watch": "webpack --watch",
        "package": "webpack --mode production --devtool hidden-source-map",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/glob": "^8.1.0",
        "@types/mocha": "^10.0.1",
        "@types/node": "20.2.5",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@types/vscode": "^1.80.0",
        "@typescript-eslint/eslint-plugin": "^5.59.8",
        "@typescript-eslint/parser": "^5.59.8",
        "@vscode/test-electron": "^2.3.2",
        "css-loader": "^6.8.1",
        "eslint": "^8.41.0",
        "glob": "^8.1.0",
        "mocha": "^10.2.0",
        "process": "^0.11.10",
        "style-loader": "^3.3.3",
        "ts-loader": "^9.4.3",
        "typescript": "^5.1.3",
        "webpack": "^5.85.0",
        "webpack-cli": "^5.1.1"
    },
    "dependencies": {
        "@ant-design/icons": "^5.2.6",
        "antd": "^5.11.5",
        "react": "^18.2.0",
        "react-dom": "^18.2.0"
    }
}