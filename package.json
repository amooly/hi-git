{
  "name": "hi-git",
  "displayName": "Hi Git",
  "description": "Beautiful Git graph visualization for VS Code",
  "version": "0.0.1",
  "publisher": "Mooly",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hi-git.showGraph",
        "title": "Hi Git: Show Graph",
        "icon": "$(git-branch)"
      },
      {
        "command": "hi-git.refreshSidebar",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "hi-git.pinpointCommit",
        "title": "Reveal Current Commit in Graph",
        "icon": "$(target)"
      },
      {
        "command": "hi-git.collapseCompareView",
        "title": "Collapse All",
        "icon": "$(collapse-all)"
      },
      {
        "command": "hi-git.expandCompareView",
        "title": "Expand All",
        "icon": "$(expand-all)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "hi-git.pinpointCommit",
          "when": "view == hi-git.sidebarView",
          "group": "navigation@1"
        },
        {
          "command": "hi-git.refreshSidebar",
          "when": "view == hi-git.sidebarView",
          "group": "navigation@2"
        },
        {
          "command": "hi-git.collapseCompareView",
          "when": "view == hi-git.compareView && !hi-git.compareCollapsed",
          "group": "navigation@1"
        },
        {
          "command": "hi-git.expandCompareView",
          "when": "view == hi-git.compareView && hi-git.compareCollapsed",
          "group": "navigation@1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hi-git",
          "title": "Hi Git",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "hi-git": [
        {
          "type": "webview",
          "id": "hi-git.sidebarView",
          "name": "Branches / Tags"
        },
        {
          "type": "webview",
          "id": "hi-git.detailsView",
          "name": "Details"
        },
        {
          "type": "tree",
          "id": "hi-git.compareView",
          "name": "Compare"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run compile && vsce package",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
