{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2020",
    "lib": ["ES2020"],
    "outDir": "out",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@services/*": ["src/extension/services/*"],
      "@panels/*": ["src/extension/panels/*"],
      "@utilities/*": ["src/extension/utilities/*"],
      "@shared/*": ["src/shared/*"]
    },
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "out", "src/webview", "media"]
}
